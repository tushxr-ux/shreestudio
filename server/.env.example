# ShreeStudio Server Configuration

PORT=4000
NODE_ENV=development
JWT_SECRET=CHANGE_ME_use_a_64char_random_string
ADMIN_EMAIL=admin@shreestudio.com

# Supabase Credentials
# Get these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Payment Credentials
# Get these from your Razorpay Dashboard: Settings -> API Keys (Test mode or Live mode)
RAZORPAY_KEY_ID=rzp_test_key_id_placeholder
RAZORPAY_KEY_SECRET=rzp_test_key_secret_placeholder

# Client Origin (for CORS in production)
# CLIENT_ORIGIN=https://your-domain.com

# SMTP Email Configuration (Nodemailer)
# Optional: Set these to send live emails via Gmail, SendGrid, Resend, etc.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=ShreeStudio Orders <orders@shreestudio.com>
